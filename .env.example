VITE_NODE_ENV=development
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-anon-publique

# IMPORTANT : les identifiants SMTP (Hostinger) ne vont PAS ici.
# Le .env est public (embarqué dans le JS du navigateur).
# Ils se configurent dans les secrets de l'Edge Function Supabase :
#   supabase secrets set SMTP_USER=... SMTP_PASSWORD=... SMTP_FROM=...
