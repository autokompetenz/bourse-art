VITE_NODE_ENV=development
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-anon-publique
# Origine publique du site (définie sur Vercel en production, PAS en local :
# ex. https://www.boursemarket.business) pour que les liens de confirmation
# ne pointent jamais vers localhost.
# VITE_SITE_URL=https://www.boursemarket.business

# IMPORTANT : les identifiants SMTP (Hostinger) ne vont PAS ici.
# Le .env est public (embarqué dans le JS du navigateur).
# Ils se configurent dans les variables d'environnement Vercel :
#   SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD, SMTP_FROM
#   SITE_URL (ex. https://www.boursemarket.business) pour le lien de confirmation
#   SUPABASE_SERVICE_ROLE_KEY (côté serveur uniquement, ne jamais exposer)
# (voir README.md → Emails)
